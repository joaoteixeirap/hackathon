# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server and scripts only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Connect → Session pooler), used by `pnpm db:reset` on a hosted project.
# Leave empty to use the local Docker stack.
SUPABASE_DB_URL=

NEXT_PUBLIC_DEFAULT_CITY=santos
# Free vector style with OSM attribution (OpenFreeMap "liberty")
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty



# Optional: privacy contact shown on /sobre (LGPD requests). Leave empty to say "fale com a equipe".
NEXT_PUBLIC_CONTACT_EMAIL=

# Demo login (SPEC_V2 V0): buttons "Entrar como nômade A / B / parceiro" on /entrar and /perfil.
# Run `pnpm seed:demo` after setting the password. Demo accounts are never admins.
NEXT_PUBLIC_DEMO_LOGIN=false
# Server only. 12+ random characters.
DEMO_LOGIN_PASSWORD=
# Protects /api/cron/* (Vercel Cron sends it as a Bearer token). Random string.
CRON_SECRET=
